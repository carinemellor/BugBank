{
  "name": "bugbank---cypress",
  "version": "1.0.0",
  "description": "Suíte de Testes Automatizados E2E no BugBank com Cypress e Page Objects",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome --headless",
    "cy:run:firefox": "cypress run --browser firefox --headless",
    "cy:run:edge": "cypress run --browser edge --headless",
    "clean:reports": "node -e \"const fs=require('fs'); fs.rmSync('cypress/reports', {recursive: true, force: true});\"",
    "report:merge": "npx mochawesome-merge cypress/reports/mochawesome/*.json -o cypress/reports/report.json",
    "report:generate": "npx marge cypress/reports/report.json -f index -o cypress/reports",
    "cy:report": "npm run clean:reports && cypress run && npm run report:merge && npm run report:generate",
    "k6:run": "k6 run k6/teste-carga.js",
    "k6:smoke": "k6 run --vus 1 --duration 10s k6/teste-carga.js",
    "test": "npm run cy:run"
  },
  "keywords": [
    "cypress",
    "qa",
    "testing",
    "bugbank",
    "e2e",
    "automation",
    "page-objects"
  ],
  "author": "Carine",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^9.5.1",
    "cypress": "^16.2.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
